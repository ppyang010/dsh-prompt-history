new file mode 100644
--- /dev/null
+++ b/src/client/annotations/externalQuotes.ts
@@ -0,0 +1,15 @@
+interface PromptHistoryQuotes {
+  has(sessionId: string): boolean
+  capture(sessionId: string): { text: string; accept(): void } | null
+}
+
+/** 无提示词历史插件时自然退化，不改变原生提交行为。 */
+export function externalQuotes(): PromptHistoryQuotes | undefined {
+  if (typeof window === 'undefined') return undefined
+  return (window as Window & { __dshPromptHistoryQuotes?: PromptHistoryQuotes }).__dshPromptHistoryQuotes
+}
+
+export function subscribeExternalQuotes(notify: () => void): () => void {
+  window.addEventListener('dsh-ph-pending-quotes', notify)
+  return () => window.removeEventListener('dsh-ph-pending-quotes', notify)
+}
